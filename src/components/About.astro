---
import { User } from 'lucide-astro'

const { summary } = Astro.props
---

<section class="mb-14">
  <h2
    class="text-xl font-bold text-zinc-100 uppercase tracking-widest border-b border-zinc-800 pb-3 mb-6 flex items-center gap-3"
  >
    <User class="w-5 h-5 text-teal-500" />
    Profile
  </h2>

  <div class="bg-zinc-900/30 border border-zinc-800/50 rounded-xl p-6 md:p-8">
    <div class="space-y-4 text-zinc-400 leading-relaxed text-base md:text-lg">
      {summary.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
