---
import { GraduationCap, MapPin, Calendar } from 'lucide-astro'

const { education } = Astro.props
---

<section class="mb-14">
  <h2
    class="text-xl font-bold text-zinc-100 uppercase tracking-widest border-b border-zinc-800 pb-3 mb-8 flex items-center gap-3"
  >
    <GraduationCap class="w-5 h-5 text-teal-500" />
    Education
  </h2>

  <div class="flex flex-col gap-6">
    {
      education.map((edu: any) => (
        <div class="group flex flex-col md:flex-row md:justify-between md:items-center gap-4 border-b border-zinc-800/40 pb-6 last:border-0 last:pb-0">
          <div>
            <h3 class="text-lg font-bold text-zinc-100 group-hover:text-teal-400 transition-colors duration-300">
              {edu.institution}
            </h3>
            <p class="text-teal-400/90 font-medium mt-1">{edu.degree}</p>
          </div>

          <div class="flex flex-col md:items-end gap-1.5 text-sm">
            <div class="flex items-center gap-1.5 italic text-zinc-400">
              <Calendar class="w-3.5 h-3.5 text-teal-500/60" />
              {edu.dates}
            </div>
            <div class="flex items-center gap-1.5 font-medium text-zinc-500">
              <MapPin class="w-3.5 h-3.5 text-teal-500/60" />
              {edu.location}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
