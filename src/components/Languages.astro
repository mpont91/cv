---
import { Languages as LanguagesIcon } from 'lucide-astro'

const { spokenLanguages } = Astro.props
---

<section class="mb-14">
  <h2
    class="text-xl font-bold text-zinc-100 uppercase tracking-widest border-b border-zinc-800 pb-3 mb-8 flex items-center gap-3"
  >
    <LanguagesIcon class="w-5 h-5 text-teal-500" />
    Languages
  </h2>

  <div class="flex flex-wrap gap-4 md:gap-6">
    {
      spokenLanguages.map((lang: any) => (
        <div class="flex items-center gap-2.5 bg-zinc-900/40 border border-zinc-800/80 px-4 py-2.5 rounded-lg cursor-default hover:border-teal-500/50 hover:bg-zinc-900/80 transition-all duration-300 hover:shadow-[0_0_10px_rgba(45,212,191,0.05)]">
          <span class="font-bold text-zinc-200">{lang.language}</span>
          <span class="text-zinc-700">|</span>
          <span class="text-sm text-teal-400/90 font-medium">
            {lang.proficiency}
          </span>
        </div>
      ))
    }
  </div>
</section>
