---
import { Code2 } from 'lucide-astro'

const { skills } = Astro.props
---

<section class="mb-14">
  <h2
    class="text-xl font-bold text-zinc-100 uppercase tracking-widest border-b border-zinc-800 pb-3 mb-8 flex items-center gap-3"
  >
    <Code2 class="w-5 h-5 text-teal-500" />
    Technical Skills
  </h2>

  <div class="flex flex-col gap-6">
    {
      skills.map((skillGroup: any) => (
        <div class="flex flex-col md:flex-row md:items-start gap-3 md:gap-8 border-b border-zinc-800/40 pb-6 last:border-0 last:pb-0">
          <h3 class="w-full md:w-56 shrink-0 text-sm font-mono text-zinc-400 uppercase tracking-wider mt-1 flex items-center gap-2">
            <span class="h-px w-4 bg-teal-500/50 hidden md:block" />
            {skillGroup.category}
          </h3>

          <div class="flex flex-wrap gap-2.5 flex-1">
            {skillGroup.items.split(',').map((item: string) => (
              <span class="px-3.5 py-1.5 bg-zinc-900/40 border border-zinc-800/80 rounded-lg text-sm font-medium text-zinc-300 hover:text-teal-400 hover:border-teal-500/50 hover:bg-zinc-900/80 transition-all duration-300 cursor-default hover:shadow-[0_0_10px_rgba(45,212,191,0.05)] hover:-translate-y-0.5">
                {item.trim()}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
