---
import { MapPin, Mail, Globe, Linkedin, Github, FileDown } from 'lucide-astro'

const { basics } = Astro.props
---

<header class="text-center mb-12">
  <h1
    class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-zinc-100 to-zinc-400 tracking-tight mb-2"
  >
    {basics.name}
  </h1>

  <p class="text-xl font-medium text-teal-400/90 tracking-wide mb-5">
    {basics.title}
  </p>

  <div
    class="flex flex-wrap justify-center items-center gap-x-4 gap-y-2 text-sm text-zinc-400 mb-8"
  >
    <span class="flex items-center gap-1.5 cursor-default">
      <MapPin class="w-4 h-4 text-teal-500/70" />
      {basics.location}
    </span>

    <span class="hidden sm:inline text-zinc-700">|</span>

    <a
      href={`mailto:${basics.email}`}
      class="group flex items-center gap-1.5 hover:text-teal-400 transition-colors"
    >
      <Mail
        class="w-4 h-4 text-teal-500/70 group-hover:text-teal-400 transition-colors"
      />
      {basics.email}
    </a>

    <span class="hidden sm:inline text-zinc-700">|</span>

    <a
      href={basics.website}
      target="_blank"
      class="group flex items-center gap-1.5 hover:text-teal-400 transition-colors"
    >
      <Globe
        class="w-4 h-4 text-teal-500/70 group-hover:text-teal-400 transition-colors"
      />
      mpont91.com
    </a>

    <span class="hidden sm:inline text-zinc-700">|</span>

    <a
      href={basics.linkedin}
      target="_blank"
      class="group flex items-center gap-1.5 hover:text-teal-400 transition-colors"
    >
      <Linkedin
        class="w-4 h-4 text-teal-500/70 group-hover:text-teal-400 transition-colors"
      />
      LinkedIn
    </a>

    <span class="hidden sm:inline text-zinc-700">|</span>

    <a
      href={basics.github}
      target="_blank"
      class="group flex items-center gap-1.5 hover:text-teal-400 transition-colors"
    >
      <Github
        class="w-4 h-4 text-teal-500/70 group-hover:text-teal-400 transition-colors"
      />
      GitHub
    </a>
  </div>

  <div class="flex justify-center">
    <a
      href="/resume.pdf"
      download
      class="inline-flex items-center gap-2 px-5 py-2.5 bg-teal-500/10 text-teal-400 border border-teal-500/30 rounded-lg text-sm font-semibold hover:bg-teal-500 hover:text-zinc-950 hover:scale-105 transition-all duration-300 shadow-lg shadow-teal-500/10"
    >
      <FileDown class="w-5 h-5" />
      Download Resume
    </a>
  </div>
</header>
