---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
const { title = 'Marc Pont | Senior Full Stack Developer' } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>

  <body
    class="bg-zinc-950 text-zinc-400 font-sans antialiased min-h-screen py-8 md:py-16 px-4 sm:px-6"
  >
    <main
      class="max-w-4xl mx-auto bg-zinc-900/80 border border-zinc-800 rounded-xl md:rounded-2xl shadow-2xl shadow-black/50 overflow-hidden"
    >
      <div class="px-6 py-12 md:px-16 md:py-16">
        <slot />
      </div>
    </main>
  </body>
</html>
